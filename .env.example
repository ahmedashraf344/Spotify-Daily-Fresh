# Spotify Developer Dashboard app
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Filled by `npm run login` (also written to .tokens.json)
SPOTIFY_REFRESH_TOKEN=

# OAuth redirect — must match Dashboard exactly
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8787/callback

# Market for search bias (ISO country)
SPOTIFY_MARKET=EG
